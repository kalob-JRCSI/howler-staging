{
  "compilerOptions": {
    "exactOptionalPropertyTypes": true,
    "lib": ["ES2024"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2024"
  },
  "include": [
    "src/worker/**/*.ts",
    "src/operator/**/*.ts",
    "src/engine/**/*.ts",
    "src/domain/**/*.ts",
    "worker-configuration.d.ts"
  ]
}
