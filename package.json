{
  "name": "howler-staging",
  "private": true,
  "version": "0.9.0",
  "scripts": {
    "postinstall": "node -e \"const fs=require('fs'),z=require('zlib');fs.writeFileSync('worker.js',z.gunzipSync(Buffer.from('','base64')));fs.writeFileSync('wrangler.jsonc',z.gunzipSync(Buffer.from('','base64')));\"",
    "deploy": "wrangler deploy",
    "check": "wrangler deploy --dry-run"
  },
  "devDependencies": {
    "wrangler": "4.68.0"
  }
}